{
  "schemaVersion": 1,
  "id": "deebosh.hotkeys",
  "name": "Hotkeys",
  "version": "1.0.0",
  "author": "deebosh",
  "license": "MIT",
  "description": "Hotkeys of the focused app: bar-center icon, searchable popup on click or SUPER+SHIFT+K. 102 apps, 6 languages.",
  "homepage": "https://github.com/deebosh/omarchy-hotkeys",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Hotkeys",
    "description": "Shows hotkeys of the currently focused application",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "showGlobals": "Off",
      "compact": "Off",
      "maxItems": 0
    },
    "schema": [
      {
        "key": "showGlobals",
        "type": "enum",
        "label": "Show global bindings",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "Off",
        "description": "When On, global Hyprland bindings are appended at the bottom of the panel."
      },
      {
        "key": "compact",
        "type": "enum",
        "label": "Compact view",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "Off",
        "description": "When On, the panel hides group headers and tightens spacing."
      },
      {
        "key": "maxItems",
        "type": "integer",
        "label": "Entry limit",
        "min": 0,
        "max": 500,
        "step": 10,
        "defaultValue": 0,
        "description": "Maximum panel entries. 0 means unlimited."
      }
    ]
  }
}
