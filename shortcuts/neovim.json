{
  "appId": "neovim",
  "displayName": "Neovim",
  "source": "https://neovim.io/doc/user/quickref.html",
  "note": "Default leader: space is unset, shown as \\. LSP bindings are the Neovim 0.11+ defaults",
  "noteRu": "Лидер по умолчанию: пробел не задан, показан \\. LSP-биндинги — дефолты Neovim 0.11+",
  "groups": [
    {
      "title": "Movement (normal)",
      "titleRu": "Движение (normal)",
      "items": [
        {
          "keys": [
            "h j k l"
          ],
          "action": "Left / down / up / right",
          "actionRu": "Влево / вниз / вверх / вправо"
        },
        {
          "keys": [
            "w b e"
          ],
          "action": "Words forward / backward / to end of word",
          "actionRu": "Следующее слово / назад / конец слова"
        },
        {
          "keys": [
            "W B E"
          ],
          "action": "Same for blank-separated WORDs",
          "actionRu": "То же по WORD (до пробела)"
        },
        {
          "keys": [
            "0 ^ $"
          ],
          "action": "First character / first non-blank / end of line",
          "actionRu": "Начало строки / первый символ / конец строки"
        },
        {
          "keys": [
            "gg G"
          ],
          "action": "First / last line of file",
          "actionRu": "Начало / конец файла"
        },
        {
          "keys": [
            "H M L"
          ],
          "action": "Top / middle / bottom line of window",
          "actionRu": "Верх / середина / низ экрана"
        },
        {
          "keys": [
            "Ctrl+U Ctrl+D"
          ],
          "action": "Half-window up / down",
          "actionRu": "Полстраницы вверх / вниз"
        },
        {
          "keys": [
            "Ctrl+B Ctrl+F"
          ],
          "action": "Full page up / down",
          "actionRu": "Страница вверх / вниз"
        },
        {
          "keys": [
            "{ }"
          ],
          "action": "Paragraphs backward / forward",
          "actionRu": "Абзац назад / вперёд"
        },
        {
          "keys": [
            "%"
          ],
          "action": "Go to matching bracket",
          "actionRu": "К парной скобке"
        },
        {
          "keys": [
            "* #"
          ],
          "action": "Search forward / backward for word under cursor",
          "actionRu": "Следующее / предыдущее вхождение слова"
