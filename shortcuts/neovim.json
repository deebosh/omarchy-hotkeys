          "action": "Go to position before last jump",
          "actionRu": "Вернуться к метке / позиции"
        },
        {
          "keys": [
            "Ctrl+O Ctrl+I"
          ],
          "action": "Older / newer position in jump list",
          "actionRu": "Назад / вперёд по jumplist"
        }
      ]
    },
    {
