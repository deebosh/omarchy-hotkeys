{
  "appId": "evolution",
  "displayName": "Evolution",
  "source": "https://help.gnome.org/users/evolution/stable/ (справка Evolution)",
  "note": "Main Evolution hotkeys; the documented set is small",
  "noteRu": "Основные хоткеи Evolution; задокументированный набор невелик",
  "groups": [
    {
      "title": "Messages",
      "titleDe": "E-Mail",
      "titleFr": "Messagerie",
      "titleEs": "Correo",
      "titleRu": "Сообщения",
      "items": [
        {
          "keys": [
            "Ctrl+N"
          ],
          "action": "Create a new message",
          "actionDe": "Eine neue E-Mail-Nachricht verfassen",
          "actionFr": "Créer un nouveau message",
          "actionEs": "Redactar un mensaje de correo nuevo",
          "actionRu": "Новое сообщение"
        },
        {
          "keys": [
            "Ctrl+R"
          ],
          "action": "Reply to sender",
          "actionDe": "Antwort an Absender",
          "actionFr": "Répondre à l'expéditeur",
          "actionEs": "Responder al remitente",
          "actionRu": "Ответить"
        },
        {
          "keys": [
            "Ctrl+Shift+R"
          ],
          "action": "Reply to all recipients",
          "actionDe": "Antwort an alle Empfänger senden",
          "actionFr": "Répondre à tous les destinataires",
          "actionEs": "Responder a todos",
          "actionRu": "Ответить всем"
        },
        {
          "keys": [
            "Ctrl+L"
          ],
          "action": "Forward selection",
          "actionDe": "Auswahl weiterleiten",
          "actionFr": "Faire suivre la sélection",
          "actionEs": "Selección de reenvío",
          "actionRu": "Переслать"
        },
        {
          "keys": [
            "Ctrl+Enter"
          ],
          "action": "Send message",
          "actionRu": "Отправить сообщение"
        },
        {
          "keys": [
            "Delete"
          ],
          "action": "Delete selection",
          "actionDe": "Auswahl löschen",
          "actionFr": "Supprimer la sélection",
          "actionEs": "Eliminar la selección",
          "actionRu": "Удалить сообщение"
        }
      ]
    },
    {
      "title": "Mail",
      "titleRu": "Почта",
      "items": [
        {
          "keys": [
            "F9"
          ],
          "action": "Send and receive messages",
          "actionDe": "Nachrichten senden und abrufen",
          "actionFr": "Envoyer et recevoir des messages",
          "actionEs": "Enviar y recibir mensajes",
          "actionRu": "Отправить / получить почту"
        },
        {
          "keys": [
            "Ctrl+1",
            "Ctrl+2",
            "Ctrl+3",
            "Ctrl+4"
          ],
          "action": "Select Mail / Contacts / Calendars / Tasks components",
          "actionDe": "Nachrichten- / Kontakte- / Kalender- / Aufgaben-Komponente auswählen",
          "actionFr": "Sélectionner le composant Courriel / Contacts / Agenda / Tâches",
          "actionEs": "Seleccione el componente Correo / Contactos / Calendario / Tareas",
          "actionRu": "Почта / Контакты / Календари / Задачи"
        },
        {
          "keys": [
            "Ctrl+E"
          ],
          "action": "Search messages",
          "actionRu": "Поиск сообщений"
        },
        {
          "keys": [
            "]",
            "["
          ],
          "action": "Jump to next / previous unread message",
          "actionDe": "Zur nächsten ungelesenen Nachricht wechseln / Zur vorhergehenden ungelesenen Nachricht wechseln",
          "actionFr": "Aller au message non lu suivant / Aller au message non lu précédent",
          "actionEs": "Saltar al siguiente mensaje sin leer / Saltar al anterior mensaje sin leer",
          "actionRu": "Следующее / предыдущее сообщение"
        }
      ]
    },
    {
      "title": "Global",
      "titleRu": "Файл и вид",
      "items": [
        {
          "keys": [
            "Ctrl+S"
          ],
          "action": "Save selection",
          "actionDe": "Auswahl speichern",
          "actionFr": "Enregistrer la sélection",
          "actionEs": "Guardar selección",
          "actionRu": "Сохранить"
        },
        {
          "keys": [
            "Ctrl+P"
          ],
          "action": "Print selection",
          "actionDe": "Auswahl drucken",
          "actionFr": "Imprimer la sélection",
          "actionEs": "Imprimir la selección",
          "actionRu": "Печать"
        },
        {
          "keys": [
            "Ctrl+Q"
          ],
          "action": "Quit Evolution",
          "actionDe": "Evolution beenden",
          "actionFr": "Quitter Evolution",
          "actionEs": "Salir de Evolution",
          "actionRu": "Выйти"
        },
        {
          "keys": [
            "Ctrl+W"
          ],
          "action": "Close window",
          "actionDe": "Fenster schließen",
          "actionFr": "Fermer la fenêtre",
          "actionEs": "Cerrar ventana",
          "actionRu": "Закрыть окно"
        }
      ]
    }
  ]
}
