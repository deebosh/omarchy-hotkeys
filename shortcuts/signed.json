{
  "appId": "signed",
  "displayName": "Signed",
  "source": "https://github.com/omacom/signed (packaged README, Hotkeys)",
  "note": "Letter keys do nothing while you're typing.",
  "groups": [
    {
      "title": "File",
      "titleDe": "Datei",
      "titleFr": "Fichier",
      "titleEs": "Archivo",
      "titlePt": "Arquivo",
      "items": [
        {
          "keys": [
            "Ctrl+O"
          ],
          "action": "Open a PDF"
        },
        {
          "keys": [
            "Ctrl+S"
          ],
          "action": "Save a signed copy"
        },
        {
          "keys": [
            "Q"
          ],
          "action": "Quit (asks first if there's anything unsaved)"
        }
      ]
    },
    {
      "title": "Placing content",
      "items": [
        {
          "keys": [
            "S"
          ],
          "action": "Place the last-used signature"
        },
        {
          "keys": [
            "Shift+S"
          ],
          "action": "Open the signature menu"
        },
        {
          "keys": [
            "T"
          ],
          "action": "Place text"
        },
        {
          "keys": [
            "D"
          ],
          "action": "Place today's date"
        },
        {
          "keys": [
            "Enter"
          ],
          "action": "Edit the selected text"
        }
      ]
    },
    {
      "title": "Selection",
      "items": [
        {
          "keys": [
            "Arrows"
          ],
          "action": "Nudge the selection 1 pt"
        },
        {
          "keys": [
            "Shift+Arrows"
          ],
          "action": "Nudge the selection 10 pt"
        },
        {
          "keys": [
            "["
          ],
          "action": "Make the selection smaller"
        },
        {
          "keys": [
            "]"
          ],
          "action": "Make the selection larger"
        },
        {
          "keys": [
            "Ctrl+D"
          ],
          "action": "Duplicate the selection"
        },
        {
          "keys": [
            "Delete",
            "Backspace",
            "X"
          ],
          "action": "Remove the selection"
        },
        {
          "keys": [
            "Esc"
          ],
          "action": "Deselect / stop editing"
        }
      ]
    },
    {
      "title": "View",
      "items": [
        {
          "keys": [
            "Page Up",
            "Page Down"
          ],
          "action": "Previous / next page"
        },
        {
          "keys": [
            "Ctrl+="
          ],
          "action": "Zoom in"
        },
        {
          "keys": [
            "Ctrl+-"
          ],
          "action": "Zoom out"
        },
        {
          "keys": [
            "Ctrl+0"
          ],
          "action": "Fit page"
        },
        {
          "keys": [
            "Ctrl+scroll"
          ],
          "action": "Zoom with the wheel"
        },
        {
          "keys": [
            "Ctrl+Z"
          ],
          "action": "Undo"
        },
        {
          "keys": [
            "Ctrl+Shift+Z"
          ],
          "action": "Redo"
        },
        {
          "keys": [
            "?"
          ],
          "action": "Show the hotkeys in the app"
        }
      ]
    }
  ]
}