        { "keys": ["g then h"], "action": "Home", "actionRu": "Домой" },
        { "keys": ["g then j"], "action": "Journals", "actionRu": "Журналы (дневник)" },
        { "keys": ["t then t"], "action": "Dark / light theme", "actionRu": "Тёмная / светлая тема" }
      ]
    },
    {
      "title": "Block editor", "titleRu": "Редактор блоков",
      "items": [
        { "keys": ["Enter"], "action": "Edit block / new block", "actionRu": "Редактировать блок / новый блок" },
