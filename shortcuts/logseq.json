        { "keys": ["Ctrl+B"], "action": "Bold", "actionRu": "Жирный" },
        { "keys": ["Ctrl+I"], "action": "Italic", "actionRu": "Курсив" },
        { "keys": ["Ctrl+."], "action": "Zoom block in", "actionRu": "Приблизить блок (zoom in)" },
        { "keys": ["Ctrl+,"], "action": "Zoom block out", "actionRu": "Отдалить блок (zoom out)" }
