      "items": [
        {
          "keys": [
            "Ctrl+N",
            "Ctrl+Shift+K"
          ],
          "action": "Compose a new message",
          "actionRu": "Новое сообщение"
        },
        {
          "keys": [
            "Ctrl+/"
          ],
          "action": "Show all keyboard shortcuts",
          "actionRu": "Показать все горячие клавиши"
