{
  "appId": "hype",
  "displayName": "Hype",
  "source": "https://github.com/omacom/hype (packaged README, Keyboard shortcuts)",
  "note": "Slide navigation and selection shortcuts apply when the sidebar or preview has focus.",
  "groups": [
    {
      "title": "File",
      "titleDe": "Datei",
      "titleFr": "Fichier",
      "titleEs": "Archivo",
      "titlePt": "Arquivo",
      "items": [
        {
          "keys": [
            "Ctrl+N"
          ],
          "action": "New presentation"
        },
        {
          "keys": [
            "Ctrl+O"
          ],
          "action": "Open file"
        },
        {
          "keys": [
            "Ctrl+S"
          ],
          "action": "Save"
        },
        {
          "keys": [
            "Ctrl+Shift+S"
          ],
          "action": "Save as"
        },
        {
          "keys": [
            "Ctrl+E"
          ],
          "action": "Export as PDF"
        },
        {
          "keys": [
            "Ctrl+Shift+E"
          ],
          "action": "Export as PowerPoint"
        }
      ]
    },
    {
      "title": "Editing",
      "items": [
        {
          "keys": [
            "Ctrl+Z"
          ],
          "action": "Undo"
        },
        {
          "keys": [
            "Ctrl+Shift+Z"
          ],
          "action": "Redo"
        },
        {
          "keys": [
            "Ctrl+B"
          ],
          "action": "Bold"
        },
        {
          "keys": [
            "Ctrl+I"
          ],
          "action": "Italic"
        },
        {
          "keys": [
            "Ctrl+U"
          ],
          "action": "Underline"
        },
        {
          "keys": [
            "Ctrl+H"
          ],
          "action": "Headline"
        },
        {
          "keys": [
            "Ctrl+K"
          ],
          "action": "Code block"
        },
        {
          "keys": [
            "Ctrl+/"
          ],
          "action": "Hidden comment"
        },
        {
          "keys": [
            "Ctrl+V"
          ],
          "action": "Paste text or add and name media"
        }
      ]
    },
    {
      "title": "Slides",
      "items": [
        {
          "keys": [
            "Ctrl+Enter"
          ],
          "action": "Add a slide"
        },
        {
          "keys": [
            "Ctrl+D"
          ],
          "action": "Duplicate selected slides"
        },
        {
          "keys": [
            "Delete"
          ],
          "action": "Delete selected slides"
        },
        {
          "keys": [
            "Ctrl+Up",
            "Ctrl+Left"
          ],
          "action": "Move selected slides earlier"
        },
        {
          "keys": [
            "Ctrl+Down",
            "Ctrl+Right"
          ],
          "action": "Move selected slides later"
        },
        {
          "keys": [
            "Ctrl+PageUp",
            "Ctrl+PageDown"
          ],
          "action": "Move selected slides five places earlier / later"
        },
        {
          "keys": [
            "Ctrl+Home",
            "Ctrl+End"
          ],
          "action": "Move selected slides to the beginning / end"
        },
        {
          "keys": [
            "Shift+arrows",
            "Shift+click"
          ],
          "action": "Extend the slide selection"
        }
      ]
    },
    {
      "title": "Navigation",
      "items": [
        {
          "keys": [
            "Arrow keys"
          ],
          "action": "Previous / next slide; up and down move by a row in Overview"
        },
        {
          "keys": [
            "Page Up",
            "Page Down"
          ],
          "action": "Jump five slides, or five rows in Overview"
        },
        {
          "keys": [
            "Home",
            "End"
          ],
          "action": "First / last slide, or start / end of line in a text box"
        },
        {
          "keys": [
            "Enter"
          ],
          "action": "Open the selected slide from Overview"
        },
        {
          "keys": [
            "Tab",
            "Shift+Tab"
          ],
          "action": "Switch between sidebar and Markdown input"
        },
        {
          "keys": [
            "Ctrl+M"
          ],
          "action": "Overview on / off"
        },
        {
          "keys": [
            "Ctrl+."
          ],
          "action": "Markdown source on / off"
        }
      ]
    },
    {
      "title": "Presentation",
      "items": [
        {
          "keys": [
            "Ctrl+Space",
            "F5"
          ],
          "action": "Toggle presentation"
        },
        {
          "keys": [
            "Shift+F5"
          ],
          "action": "Start presentation from the first slide"
        },
        {
          "keys": [
            "Escape"
          ],
          "action": "Leave presentation"
        },
        {
          "keys": [
            "Space"
          ],
          "action": "Play / pause video while presenting"
        },
        {
          "keys": [
            "? ",
            "F1"
          ],
          "action": "Show all shortcuts"
        }
      ]
    }
  ]
}