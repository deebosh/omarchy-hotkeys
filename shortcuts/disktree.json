{
  "appId": "disktree",
  "displayName": "disktree",
  "source": "https://github.com/tobi/disktree (packaged README, keys table)",
  "groups": [
    {
      "title": "Selection",
      "titleDe": "Auswahl",
      "titleFr": "Sélection",
      "titleEs": "Selección",
      "titlePt": "Seleção",
      "items": [
        {
          "keys": [
            "Space",
            "X"
          ],
          "action": "Mark or unmark the tile you point at"
        },
        {
          "keys": [
            "Ctrl+click"
          ],
          "action": "Mark without moving the selection"
        },
        {
          "keys": [
            "Arrows"
          ],
          "action": "Move between tiles at this level"
        },
        {
          "keys": [
            "Tab"
          ],
          "action": "Next largest sibling"
        },
        {
          "keys": [
            "Enter"
          ],
          "action": "Open that directory, at any depth"
        },
        {
          "keys": [
            "Backspace",
            "Esc"
          ],
          "action": "Go up one directory"
        },
        {
          "keys": [
            "Alt+Left",
            "Alt+Right"
          ],
          "action": "Back and forward through where you have been"
        }
      ]
    },
    {
      "title": "View",
      "items": [
        {
          "keys": [
            "scroll"
          ],
          "action": "Zoom toward a directory, then go into it"
        },
        {
          "keys": [
            "Shift+scroll"
          ],
          "action": "Pan the magnified view"
        },
        {
          "keys": [
            "[",
            "]"
          ],
          "action": "Draw fewer or more levels at once"
        },
        {
          "keys": [
            "-",
            "=",
            "0"
          ],
          "action": "Magnify, shrink, reset the view"
        },
        {
          "keys": [
            "Ctrl+=",
            "Ctrl+-",
            "Ctrl+0"
          ],
          "action": "Interface zoom"
        },
        {
          "keys": [
            "P"
          ],
          "action": "Show or hide the selection line"
        }
      ]
    },
    {
      "title": "Data",
      "items": [
        {
          "keys": [
            "/"
          ],
          "action": "Filter by name"
        },
        {
          "keys": [
            "C"
          ],
          "action": "Review the marked list"
        },
        {
          "keys": [
            "T"
          ],
          "action": "Size, files or age: what areas and colours say"
        },
        {
          "keys": [
            "D"
          ],
          "action": "Disk usage or apparent size"
        },
        {
          "keys": [
            "I"
          ],
          "action": "Include or skip hidden entries"
        },
        {
          "keys": [
            "R"
          ],
          "action": "Scan again"
        },
        {
          "keys": [
            "Esc"
          ],
          "action": "Stop the scan"
        },
        {
          "keys": [
            "V"
          ],
          "action": "Scan another mounted volume"
        },
        {
          "keys": [
            "Ctrl+O"
          ],
          "action": "Choose another directory to scan"
        },
        {
          "keys": [
            "G"
          ],
          "action": "The whole disk"
        },
        {
          "keys": [
            "O"
          ],
          "action": "Show it in the file manager"
        },
        {
          "keys": [
            "?"
          ],
          "action": "Every key"
        },
        {
          "keys": [
            "Q"
          ],
          "action": "Quit"
        }
      ]
    }
  ]
}