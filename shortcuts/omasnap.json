{
  "appId": "omasnap",
  "displayName": "Omasnap",
  "source": "https://github.com/omacom/omasnap (packaged README, Controls)",
  "note": "Keys are context-dependent: the capture picker, the annotation editor and previews each have their own set.",
  "groups": [
    {
      "title": "Capture selection",
      "titleDe": "Aufnahmeauswahl",
      "titleFr": "Sélection de capture",
      "titleEs": "Selección de captura",
      "titlePt": "Seleção de captura",
      "items": [
        {
          "keys": [
            "Click"
          ],
          "action": "Capture the window under the pointer, or the full monitor outside any window"
        },
        {
          "keys": [
            "Drag"
          ],
          "action": "Select a region, with its native pixel size shown at the pointer"
        },
        {
          "keys": [
            "Tab",
            "Shift+Tab"
          ],
          "action": "Cycle the region's shape: free, square, 3:4, 16:9"
        },
        {
          "keys": [
            "S"
          ],
          "action": "Toggle scrolling-region mode"
        },
        {
          "keys": [
            "E",
            "A"
          ],
          "action": "Toggle annotation after capture"
        },
        {
          "keys": [
            "R"
          ],
          "action": "Restore the last drawn region"
        },
        {
          "keys": [
            "SUPER+Arrow"
          ],
          "action": "Move among windows in window mode"
        },
        {
          "keys": [
            "Enter"
          ],
          "action": "Capture the highlighted window"
        },
        {
          "keys": [
            "Ctrl+A"
          ],
          "action": "Select the full focused monitor"
        },
        {
          "keys": [
            "Space"
          ],
          "action": "Hide or show the recent captures"
        },
        {
          "keys": [
            "Esc"
          ],
          "action": "Dismiss; cancel a selection drag if one is in progress"
        }
      ]
    },
    {
      "title": "Annotation tools",
      "titleDe": "Werkzeuge",
      "titleFr": "Outils",
      "titleEs": "Herramientas",
      "titlePt": "Ferramentas",
      "items": [
        {
          "keys": [
            "V"
          ],
          "action": "Select / move / resize layers"
        },
        {
          "keys": [
            "A"
          ],
          "action": "Arrow; press again to cycle styles"
        },
        {
          "keys": [
            "S"
          ],
          "action": "Spotlight / loupe; press again to cycle shapes"
        },
        {
          "keys": [
            "L"
          ],
          "action": "Straight line"
        },
        {
          "keys": [
            "F"
          ],
          "action": "Freehand pen"
        },
        {
          "keys": [
            "H"
          ],
          "action": "Highlighter"
        },
        {
          "keys": [
            "I"
          ],
          "action": "Eyedropper in the color popover"
        },
        {
          "keys": [
            "C"
          ],
          "action": "Numbered marker"
        },
        {
          "keys": [
            "R"
          ],
          "action": "Rectangle"
        },
        {
          "keys": [
            "E"
          ],
          "action": "Ellipse"
        },
        {
          "keys": [
            "D"
          ],
          "action": "Redact; press again to toggle pixelation or solid"
        },
        {
          "keys": [
            "X"
          ],
          "action": "Cut out a band (Ctrl to insert a band instead)"
        },
        {
          "keys": [
            "T"
          ],
          "action": "Text"
        },
        {
          "keys": [
            "Shift+T"
          ],
          "action": "Cycle the text font"
        },
        {
          "keys": [
            "O"
          ],
          "action": "Recognize and copy all text in the image"
        },
        {
          "keys": [
            "1–8"
          ],
          "action": "Set annotation color (7 black, 8 white)"
        }
      ]
    },
    {
      "title": "Editor view",
      "items": [
        {
          "keys": [
            "W"
          ],
          "action": "Re-present the editor as a normal window or fullscreen overlay"
        },
        {
          "keys": [
            "G",
            "Shift+G"
          ],
          "action": "Cycle canvas boundaries forward / backward"
        },
        {
          "keys": [
            "B"
          ],
          "action": "Cycle shadowed colors, window gray, and Off"
        },
        {
          "keys": [
            "Shift+B"
          ],
          "action": "Toggle the screenshot card's drop shadow"
        },
        {
          "keys": [
            "Ctrl+wheel"
          ],
          "action": "Zoom about the cursor"
        },
        {
          "keys": [
            "middle-drag"
          ],
          "action": "Pan"
        },
        {
          "keys": [
            "+",
            "-",
            "0"
          ],
          "action": "Zoom in / out / fit"
        },
        {
          "keys": [
            "Arrows"
          ],
          "action": "Nudge the selected layer 1 px (Shift: 10 px)"
        },
        {
          "keys": [
            "Delete"
          ],
          "action": "Delete selected layer"
        },
        {
          "keys": [
            "Alt+D"
          ],
          "action": "Duplicate selected layer"
        }
      ]
    },
    {
      "title": "Output",
      "items": [
        {
          "keys": [
            "Ctrl+C"
          ],
          "action": "Copy PNG only"
        },
        {
          "keys": [
            "Ctrl+S"
          ],
          "action": "Save PNG only"
        },
        {
          "keys": [
            "Ctrl+Shift+S"
          ],
          "action": "Save As"
        },
        {
          "keys": [
            "Enter"
          ],
          "action": "Copy and save"
        },
        {
          "keys": [
            "Ctrl+P",
            "P"
          ],
          "action": "Keep the capture pinned on screen and close the editor"
        },
        {
          "keys": [
            "Ctrl+Z"
          ],
          "action": "Undo"
        },
        {
          "keys": [
            "Ctrl+Shift+Z",
            "Ctrl+Y"
          ],
          "action": "Redo"
        },
        {
          "keys": [
            "Esc",
            "Super+W"
          ],
          "action": "Dismiss the annotator"
        }
      ]
    }
  ]
}