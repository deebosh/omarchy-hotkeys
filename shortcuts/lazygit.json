        { "keys": ["+"], "action": "Next screen mode (normal/half/fullscreen)", "actionRu": "Следующий режим экрана" },
        { "keys": ["_"], "action": "Prev screen mode", "actionRu": "Предыдущий режим экрана" },
        { "keys": ["1 2 3 4 5"], "action": "Focus: status / files / branches / commits / stash", "actionRu": "Фокус: статус / файлы / ветки / коммиты / stash" },
        { "keys": ["Ctrl+G"], "action": "Jump to file in diff", "actionRu": "Перейти к файлу в диффе" },
