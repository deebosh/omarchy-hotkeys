        { "keys": ["n"], "action": "New branch", "actionRu": "Новая ветка" },
        { "keys": ["r"], "action": "Rebase", "actionRu": "Rebase текущей ветки на выбранную" },
        { "keys": ["M"], "action": "Merge", "actionRu": "Merge выбранной в текущую" },
        { "keys": ["d"], "action": "Delete", "actionRu": "Удалить ветку" },
        { "keys": ["R"], "action": "Rename branch", "actionRu": "Переименовать ветку" },
        { "keys": ["f"], "action": "Fast-forward" },
        { "keys": ["u"], "action": "View upstream options", "actionRu": "Опции upstream" },
        { "keys": ["-"], "action": "Checkout previous branch", "actionRu": "Checkout предыдущей ветки" },
        { "keys": ["Enter"], "action": "View commits", "actionRu": "Показать коммиты ветки" }
      ]
    },
    {
      "title": "Diff", "titleRu": "Дифф",
