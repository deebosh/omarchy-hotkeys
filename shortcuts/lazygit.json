        { "keys": ["стрелки / h l"], "action": "Go to previous / next hunk", "actionRu": "Предыдущий / следующий ханк" },
        { "keys": ["Space"], "action": "Stage", "actionRu": "Stage / unstage выделение" },
        { "keys": ["v"], "action": "Toggle range select", "actionRu": "Выделение диапазоном" },
        { "keys": ["a"], "action": "Toggle hunk selection", "actionRu": "Ханк или построчный режим" },
        { "keys": ["n N"], "action": "Go to next / previous file", "actionRu": "Следующий / предыдущий файл" },
        { "keys": ["Tab"], "action": "Switch diff pane", "actionRu": "Переключить панель диффа" },
        { "keys": ["E"], "action": "Edit hunk", "actionRu": "Редактировать ханк в редакторе" }
      ]
    },
    {
      "title": "List panel navigation", "titleRu": "Навигация по спискам",
      "items": [
        { "keys": ["j k / стрелки"], "action": "Down / up", "actionRu": "Вниз / вверх" },
        { "keys": ["J K"], "action": "Scroll down / up main window", "actionRu": "Скролл вниз / вверх (main view)" },
        { "keys": ["[ ]"], "action": "Previous / next tab", "actionRu": "Предыдущий / следующий таб" },
        { "keys": ["/"], "action": "Search current view", "actionRu": "Поиск по виду" },
        { "keys": ["0"], "action": "Focus main view", "actionRu": "Фокус в главное окно" },
        { "keys": ["v"], "action": "Toggle range select", "actionRu": "Выделение диапазоном" }
