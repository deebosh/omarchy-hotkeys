{
  "appId": "lazygit",
  "displayName": "Lazygit",
  "source": "https://github.com/jesseduffield/lazygit/blob/master/docs/keybindings/Keybindings_en.md",
  "note": "Default lazygit bindings", "noteRu": "Дефолтные биндинги lazygit",
  "groups": [
    {
      "title": "Global keybindings", "titleRu": "Глобальные",
      "items": [
        { "keys": ["?"], "action": "Open keybindings menu", "actionRu": "Меню всех хоткеев" },
        { "keys": ["q", "Ctrl+C"], "action": "Quit", "actionRu": "Выйти" },
        { "keys": ["R"], "action": "Refresh", "actionRu": "Обновить git-статус" },
        { "keys": ["P"], "action": "Push", "actionRu": "Push текущей ветки" },
        { "keys": ["p"], "action": "Pull", "actionRu": "Pull текущей ветки" },
        { "keys": ["x"], "action": "Menu (panel actions)", "actionRu": "Меню (действия панели)" },
        { "keys": [":"], "action": "Execute shell command", "actionRu": "Выполнить shell-команду" },
        { "keys": ["m"], "action": "View merge/rebase options", "actionRu": "Опции merge/rebase" },
