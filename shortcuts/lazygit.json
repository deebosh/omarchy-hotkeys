        { "keys": ["Space"], "action": "Checkout", "actionRu": "Checkout коммита (detached HEAD)" },
        { "keys": ["Enter"], "action": "View files", "actionRu": "Показать файлы коммита" },
        { "keys": ["o"], "action": "Open commit in browser", "actionRu": "Открыть коммит в браузере" }
      ]
