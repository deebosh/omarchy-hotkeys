        { "keys": ["Ctrl+Shift+K"], "action": "Combines selected objects", "actionRu": "Объединить объекты" },
        { "keys": ["Ctrl+Shift+K"], "action": "Uncombines selected objects", "actionRu": "Разъединить объекты" },
        { "keys": ["Ctrl+Shift++"], "action": "Bring to front", "actionRu": "На передний план" },
        { "keys": ["Ctrl++"], "action": "Bring forward", "actionRu": "Выше" },
        { "keys": ["Ctrl+-"], "action": "Send backward", "actionRu": "Ниже" },
        { "keys": ["Ctrl+Shift+-"], "action": "Send to back", "actionRu": "На задний план" }
      ]
    },
    {
      "title": "Pages and objects",
      "titleRu": "Страницы и объекты",
      "items": [
