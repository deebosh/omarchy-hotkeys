        { "keys": ["F5"], "action": "Opens the Navigator", "actionRu": "Навигатор" },
        { "keys": ["F7"], "action": "Checks spelling", "actionRu": "Проверка орфографии" },
        { "keys": ["Ctrl+F7"], "action": "Opens the Thesaurus", "actionRu": "Тезаурус" },
        { "keys": ["F8"], "action": "Edit points on/off", "actionRu": "Режим правки точек" }
      ]
