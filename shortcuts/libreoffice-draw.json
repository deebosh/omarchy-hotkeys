    {
      "title": "Zoom and arranging",
      "titleRu": "Масштаб и порядок",
      "items": [
        { "keys": ["+"], "action": "Zooms in", "actionRu": "Увеличить" },
        { "keys": ["-"], "action": "Zooms out", "actionRu": "Уменьшить" },
        { "keys": ["Ctrl+Shift+G"], "action": "Groups selected objects", "actionRu": "Сгруппировать" },
