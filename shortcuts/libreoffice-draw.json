        { "keys": ["Ctrl+Page Up", "Ctrl+Page Down"], "action": "Switch to previous / next layer", "actionRu": "Предыдущий / следующий слой" },
        { "keys": ["Arrows"], "action": "Moves the selected object", "actionRu": "Переместить объект" },
        { "keys": ["Ctrl+Arrows"], "action": "Moves the page view", "actionRu": "Прокрутить страницу" },
        { "keys": ["Tab", "Shift+Tab"], "action": "Cycles through objects in creation order", "actionRu": "Перебор объектов" },
        { "keys": ["Esc"], "action": "Exits current mode", "actionRu": "Выйти из режима" },
        { "keys": ["Shift+F10"], "action": "Opens the context menu for the selected object", "actionRu": "Контекстное меню объекта" }
