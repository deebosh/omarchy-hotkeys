        { "keys": ["Ctrl+G"], "action": "Jump to the next match to your Find Bar search", "actionRu": "Следующее совпадение" },
        { "keys": ["Ctrl+Shift+G"], "action": "Jump to the previous match to your Find Bar search", "actionRu": "Предыдущее совпадение" },
        { "keys": ["Ctrl+Shift+Delete"], "action": "Open the Clear Browsing Data options", "actionRu": "Очистить данные просмотров" },
